# Command Aliases
alias vim='vim -u ~/.vim/.vimrc'
alias tvim='vim -u ~/.vim/test/.vimrc'
alias psg='ps -ef|grep '

# Git aliases
alias g='git'

alias pr='hub pull-request --base main'

# Fetch, rebase current branch, checkout main, pull, and merge branch
gmerge() {
  local branch=$(git branch --show-current)
  if [ -z "$branch" ]; then
    echo "Error: Not on a git branch"
    return 1
  fi
  git fetch && \
  git rebase origin/main && \
  git checkout main && \
  git pull && \
  git merge --no-ff "$branch"
}

alias gstats='g stats | sort | uniq -c | awk "{printf \"%s %s\n\", \$2, \$1}"'
alias gstatsby='git log --format="%ad %aN" --date=format:"%Y-%m" | sort | uniq -c | awk "{printf \"%s %s %s\n\", \$2, \$3, \$1}"'

# Docker aliases
alias dc='docker-compose'
alias d='docker'

# Terraform alias
alias tf='terraform'

# pnpm alias
alias p='pnpm'
alias clean-docker='clean-containers && clean-images'
alias clean-volumes='docker volume rm $(docker volume ls -qf dangling=true)'
alias clean-images='docker rmi $(docker images --filter "dangling=true" -q --no-trunc)'
alias clean-containers='docker rm $(docker ps -qa --no-trunc --filter "status=exited")'

alias cl='claude --dangerously-skip-permissions'

# Zsh-specific aliases
alias history='fc -l 1'  # Show full history
alias h='history'
alias reload='source ~/.zshrc'
alias zshconfig='$EDITOR ~/.zshrc'
alias zshaliases='$EDITOR ~/.zsh_aliases'

# Directory navigation (using zsh's auto_cd these become even more convenient)
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# Enhanced ls aliases with color
alias ls='ls -G'
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'

alias dcd='HERE=$(pwd) && cd $HERE/apps/web && docker-compose -f docker-compose.dev.yml down && cd $HERE'
alias dcu='HERE=$(pwd) && cd $HERE/apps/web && docker-compose -f docker-compose.dev.yml up -d && cd $HERE'
alias chrome='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222 --user-data-dir="$HOME/.chrome-debug"'
